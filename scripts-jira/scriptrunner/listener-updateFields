import com.adaptavist.hapi.cloud.jira.issues.Issues

def issueKey = issue.key
def eventIssue = Issues.getByKey(issueKey as String)
def toAdf(text) {
    return [
        "type": "doc",
        "version": 1,
        "content": [
            [
                "type": "paragraph",
                "content": [
                    [
                        "type": "text",
                        "text": text ?: ""
                    ]
                ]
            ]
        ]
    ]
}

logger.info("Running listener for issue ${issueKey}")

try {
    //watchers name
    def response = get("/rest/api/3/issue/${issueKey}/watchers").asObject(Map)
    def watchers = response.body.watchers ?: []
    def watcherNames = watchers.collect { it.displayName }.join(", ")

    //sprint name
    def sprintFieldValue = eventIssue.getCustomFieldValue('Sprint')
    def sprintNames = ''
    if (sprintFieldValue) {
        sprintNames = sprintFieldValue.collect { it.name }.join(', ')
    }

    //payload
    def payload = [
        fields: [
            'customfield_10001': toAdf(watcherNames),
            'customfield_10002': toAdf(sprintNames)
        ]
    ]

    //update
    logger.info("Updating fields for ${issueKey}: " +
        "[Watchers Name='${watcherNames}', Sprint Name='${sprintNames}'] with notifications suppressed.")

    def updateResponse = put("/rest/api/3/issue/${issueKey}?notifyUsers=false")
        .header('Content-Type', 'application/json')
        .body(payload)
        .asString() 

    if (updateResponse.status >= 200 && updateResponse.status < 300) {
        logger.info("Update Successful. Status: ${updateResponse.status}")
    } else {
        logger.error("Update failed. Status: ${updateResponse.status}, Response: ${updateResponse.body}")
        throw new Exception("REST API update failed.")
    }

} catch (Exception e) {
    logger.error("Listener failed: ${e.message}", e)
}
